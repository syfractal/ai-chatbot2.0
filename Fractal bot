<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Chat Collector | Real Multi-Model Aggregator</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Marked.js for Markdown & Code Rendering -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Styling Markdown outputs */
        .prose p { margin-bottom: 0.6rem; }
        .prose p:last-child { margin-bottom: 0; }
        .prose pre { background: #0f172a; border: 1px solid #334155; padding: 0.75rem; border-radius: 0.5rem; overflow-x: auto; margin: 0.5rem 0; }
        .prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; color: #38bdf8; }
        .prose pre code { color: #e2e8f0; }
        .prose ul { list-style-type: disc; padding-left: 1.2rem; margin-bottom: 0.5rem; }
        .prose ol { list-style-type: decimal; padding-left: 1.2rem; margin-bottom: 0.5rem; }
        .prose h1, .prose h2, .prose h3 { font-weight: 700; color: #f8fafc; margin-top: 0.75rem; margin-bottom: 0.4rem; }
        .prose blockquote { border-left: 3px solid #6366f1; padding-left: 0.75rem; color: #94a3b8; font-style: italic; }
        
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #090d16; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #334155; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans h-screen flex overflow-hidden antialiased">

    <!-- ================= SIDEBAR ================= -->
    <aside class="w-64 bg-slate-900/95 border-r border-slate-800 flex flex-col justify-between shrink-0 select-none">
        <div>
            <!-- Header Brand -->
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white font-bold shadow-lg shadow-indigo-500/30">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-sm text-white">AI Collector</h1>
                        <span class="text-[10px] text-indigo-400 font-mono">Live Multi-LLM</span>
                    </div>
                </div>
                <button onclick="openModal('settingsModal')" title="API Key Setup" class="text-slate-400 hover:text-white p-1.5 rounded-md hover:bg-slate-800 transition">
                    <i data-lucide="key" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Action -->
            <div class="p-3">
                <button onclick="startNewSession()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2 px-3 rounded-lg text-xs flex items-center justify-center gap-2 shadow-md shadow-indigo-600/20 transition">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    New Query Session
                </button>
            </div>

            <!-- Gems Personas -->
            <div class="px-3 py-2">
                <div class="flex items-center justify-between text-xs text-slate-400 font-semibold px-2 mb-1.5 uppercase tracking-wider">
                    <span>AI Gems</span>
                    <button onclick="openModal('gemModal')" class="text-indigo-400 hover:text-indigo-300 text-[11px] font-normal">+ New</button>
                </div>
                <div id="gemsList" class="space-y-1"></div>
            </div>

            <!-- Quick Templates -->
            <div class="px-3 py-2">
                <div class="flex items-center justify-between text-xs text-slate-400 font-semibold px-2 mb-1.5 uppercase tracking-wider">
                    <span>Quick Prompts</span>
                </div>
                <div id="promptSnippets" class="space-y-1"></div>
            </div>
        </div>

        <!-- API Key Status Indicator -->
        <div class="p-3 border-t border-slate-800 text-xs">
            <div onclick="openModal('settingsModal')" class="flex items-center justify-between bg-slate-950 p-2.5 rounded-lg border border-slate-800 cursor-pointer hover:border-slate-700 transition">
                <div class="flex items-center gap-2">
                    <div id="keyStatusDot" class="w-2 h-2 rounded-full bg-amber-500"></div>
                    <span id="keyStatusText" class="text-slate-300 font-mono text-[11px]">Key Required</span>
                </div>
                <span class="text-[10px] text-indigo-400 font-medium">Config</span>
            </div>
        </div>
    </aside>

    <!-- ================= MAIN VIEWPORT ================= -->
    <main class="flex-1 flex flex-col h-full overflow-hidden bg-slate-950">
        
        <!-- Top Navigation -->
        <header class="h-14 border-b border-slate-800 px-6 flex items-center justify-between shrink-0 bg-slate-900/40 backdrop-blur-md">
            <div class="flex items-center gap-3">
                <span class="text-xs text-slate-400 font-medium">Active Models:</span>
                <div id="modelPills" class="flex items-center gap-1.5 flex-wrap"></div>
            </div>

            <div class="flex items-center gap-2">
                <button onclick="synthesizeConsensus()" id="btnConsensus" class="text-xs bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-indigo-500/30 px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition">
                    <i data-lucide="git-merge" class="w-3.5 h-3.5 text-indigo-400"></i>
                    AI Consensus Judge
                </button>
                <button onclick="clearScreen()" class="text-xs text-slate-400 hover:text-slate-200 p-2 hover:bg-slate-800 rounded-lg transition" title="Clear View">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </div>
        </header>

        <!-- Dynamic Grid View -->
        <section class="flex-1 p-4 overflow-y-auto" id="gridContainer">
            <div id="modelsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 h-full min-h-0"></div>
        </section>

        <!-- Prompt Input Bar -->
        <footer class="p-4 border-t border-slate-800 bg-slate-900/80 backdrop-blur-md shrink-0">
            <div class="max-w-5xl mx-auto space-y-2">
                
                <div class="flex items-center justify-between text-xs px-1">
                    <div class="flex items-center gap-2">
                        <span class="text-slate-400 font-medium text-[11px] flex items-center gap-1">
                            <i data-lucide="sparkles" class="w-3 h-3 text-indigo-400"></i> Persona:
                        </span>
                        <span id="gemIndicator" class="text-[11px] font-medium text-indigo-300 bg-indigo-950/70 border border-indigo-800 px-2 py-0.5 rounded">
                            General Assistant
                        </span>
                    </div>

                    <span class="text-[11px] text-slate-500 font-mono">Press Ctrl + Enter to Send</span>
                </div>

                <div class="relative bg-slate-950 border border-slate-700 rounded-xl focus-within:border-indigo-500 focus-within:ring-1 focus-within:ring-indigo-500 transition shadow-inner">
                    <textarea 
                        id="userPrompt"
                        rows="2"
                        placeholder="Type your prompt here... Every active model will respond in real time!"
                        class="w-full bg-transparent px-4 pt-3 pb-10 text-sm text-slate-100 placeholder-slate-500 focus:outline-none resize-none"
                    ></textarea>

                    <div class="absolute bottom-2 right-3 flex items-center gap-2">
                        <button 
                            id="btnDispatch" 
                            onclick="dispatchMultiModelQuery()"
                            class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-1.5 rounded-lg text-xs flex items-center gap-1.5 shadow-md shadow-indigo-600/30 transition disabled:opacity-50"
                        >
                            <i data-lucide="send" class="w-3.5 h-3.5"></i>
                            <span>Send Query</span>
                        </button>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    <!-- ================= MODAL: API KEY SETUP ================= -->
    <div id="settingsModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md overflow-hidden shadow-2xl">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/50">
                <h3 class="font-semibold text-sm flex items-center gap-2 text-white">
                    <i data-lucide="key" class="w-4 h-4 text-indigo-400"></i> Setup Real AI Provider Key
                </h3>
                <button onclick="closeModal('settingsModal')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
            </div>
            <div class="p-5 space-y-4 text-xs leading-relaxed">
                <div class="p-3 bg-indigo-950/40 border border-indigo-800/60 rounded-lg text-slate-300">
                    <strong class="text-indigo-300">💡 Recommended (1 Key for All Models):</strong><br>
                    Get a free API Key from <a href="https://openrouter.ai/keys" target="_blank" class="text-indigo-400 underline font-medium hover:text-indigo-300">OpenRouter.ai</a>. It unlocks DeepSeek R1, GPT-4o, Claude 3.5, Gemini, and Llama instantly without extra setup.
                </div>
                
                <div>
                    <label class="block text-slate-300 font-medium mb-1">OpenRouter API Key (sk-or-...)</label>
                    <input type="password" id="inputOpenRouterKey" placeholder="sk-or-v1-..." class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2.5 text-slate-100 font-mono text-xs focus:outline-none focus:border-indigo-500">
                </div>

                <div class="border-t border-slate-800 pt-3">
                    <label class="block text-slate-400 mb-1">Alternative: Direct Groq API Key (Optional)</label>
                    <input type="password" id="inputGroqKey" placeholder="gsk_..." class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-slate-100 font-mono text-xs focus:outline-none focus:border-indigo-500">
                </div>
            </div>
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-end gap-2">
                <button onclick="closeModal('settingsModal')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs">Cancel</button>
                <button onclick="saveApiKeys()" class="px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs">Save & Connect</button>
            </div>
        </div>
    </div>

    <!-- ================= MODAL: CREATE GEM ================= -->
    <div id="gemModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md overflow-hidden shadow-2xl">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/50">
                <h3 class="font-semibold text-sm flex items-center gap-2 text-white">
                    <i data-lucide="sparkles" class="w-4 h-4 text-indigo-400"></i> Create Custom Gem Persona
                </h3>
                <button onclick="closeModal('gemModal')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
            </div>
            <div class="p-5 space-y-4 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Gem Name</label>
                    <input type="text" id="newGemName" placeholder="e.g., Python Senior Architect" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2.5 text-slate-100 focus:outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">System Instructions</label>
                    <textarea id="newGemSystem" rows="4" placeholder="You are an expert software engineer. Always return clean, optimized, production-ready code with explanations." class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2.5 text-slate-100 focus:outline-none focus:border-indigo-500 resize-none"></textarea>
                </div>
            </div>
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-end gap-2">
                <button onclick="closeModal('gemModal')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs">Cancel</button>
                <button onclick="saveNewGem()" class="px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs">Save Gem</button>
            </div>
        </div>
    </div>

    <!-- ================= JAVASCRIPT ENGINE ================= -->
    <script>
        // --- 1. MODEL CATALOG (Real OpenRouter & Groq Model IDs) ---
        const MODELS = [
            { 
                id: 'deepseek/deepseek-r1:free', 
                name: 'DeepSeek R1 (Free)', 
                provider: 'OpenRouter', 
                badge: 'Reasoning', 
                color: 'border-blue-500/40 text-blue-400', 
                active: true 
            },
            { 
                id: 'meta-llama/llama-3.3-70b-instruct:free', 
                name: 'Llama 3.3 70B (Free)', 
                provider: 'OpenRouter', 
                badge: 'Open Weight', 
                color: 'border-purple-500/40 text-purple-400', 
                active: true 
            },
            { 
                id: 'google/gemini-2.0-flash-exp:free', 
                name: 'Gemini 2.0 Flash (Free)', 
                provider: 'OpenRouter', 
                badge: 'Fast Multimodal', 
                color: 'border-cyan-500/40 text-cyan-400', 
                active: true 
            },
            { 
                id: 'openai/gpt-4o-mini', 
                name: 'GPT-4o Mini', 
                provider: 'OpenRouter', 
                badge: 'OpenAI', 
                color: 'border-emerald-500/40 text-emerald-400', 
                active: false 
            },
            { 
                id: 'anthropic/claude-3.5-sonnet', 
                name: 'Claude 3.5 Sonnet', 
                provider: 'OpenRouter', 
                badge: 'Anthropic', 
                color: 'border-amber-500/40 text-amber-400', 
                active: false 
            }
        ];

        let GEMS = [
            { id: 'default', name: 'General Assistant', system: 'You are a helpful, accurate, and concise AI assistant.', active: true },
            { id: 'coder', name: 'Senior Developer', system: 'You are a Principal Software Engineer. Provide clean, secure, and production-ready code with concise explanations.', active: false },
            { id: 'critic', name: 'Logic & Fact Checker', system: 'You are a critical thinker. Scrutinize statements, detect fallacies, and provide factually grounded counterarguments.', active: false }
        ];

        let PROMPTS = [
            { title: 'Code Refactor & Benchmark', content: 'Write a Python function to find all prime numbers up to N using the Sieve of Eratosthenes, and analyze its time complexity.' },
            { title: 'Tech Trade-off Comparison', content: 'Compare PostgreSQL vs MongoDB for a real-time event logging system. Give a summary comparison table.' },
            { title: 'Explain Like I am 12', content: 'Explain how Large Language Models actually generate tokens and understand context.' }
        ];

        let completedOutputs = {};
        let isStreaming = false;

        // --- 2. INITIALIZATION ---
        window.addEventListener('DOMContentLoaded', () => {
            renderModelPills();
            renderGridFrames();
            renderGems();
            renderPrompts();
            checkApiKeyStatus();
            lucide.createIcons();

            // Setup Enter shortcuts
            document.getElementById('userPrompt').addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    e.preventDefault();
                    dispatchMultiModelQuery();
                }
            });

            // Load saved keys into inputs
            document.getElementById('inputOpenRouterKey').value = localStorage.getItem('byok_openrouter') || '';
            document.getElementById('inputGroqKey').value = localStorage.getItem('byok_groq') || '';
        });

        // --- 3. UI RENDERING ---
        function renderModelPills() {
            const container = document.getElementById('modelPills');
            container.innerHTML = MODELS.map(m => `
                <button onclick="toggleModel('${m.id}')" class="text-xs px-2.5 py-1 rounded-full border transition flex items-center gap-1.5 ${
                    m.active ? 'bg-indigo-950/70 border-indigo-500 text-indigo-300 font-medium' : 'bg-slate-900 border-slate-800 text-slate-500 hover:text-slate-300'
                }">
                    <span class="w-1.5 h-1.5 rounded-full ${m.active ? 'bg-indigo-400' : 'bg-slate-600'}"></span>
                    ${m.name}
                </button>
            `).join('');
        }

        function toggleModel(id) {
            const m = MODELS.find(x => x.id === id);
            if (m) {
                const count = MODELS.filter(x => x.active).length;
                if (m.active && count <= 1) {
                    alert('Keep at least one model active for comparison.');
                    return;
                }
                m.active = !m.active;
                renderModelPills();
                renderGridFrames();
            }
        }

        function renderGridFrames() {
            const grid = document.getElementById('modelsGrid');
            const activeModels = MODELS.filter(m => m.active);
            
            if (activeModels.length === 1) grid.className = "grid grid-cols-1 gap-4 h-full min-h-0";
            else if (activeModels.length === 2) grid.className = "grid grid-cols-1 md:grid-cols-2 gap-4 h-full min-h-0";
            else if (activeModels.length === 3) grid.className = "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 h-full min-h-0";
            else grid.className = "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-4 h-full min-h-0";

            grid.innerHTML = activeModels.map(m => `
                <div class="bg-slate-900 border border-slate-800 rounded-xl flex flex-col overflow-hidden shadow-lg transition hover:border-slate-700">
                    <div class="p-3 border-b border-slate-800 bg-slate-950/50 flex items-center justify-between shrink-0">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-white tracking-wide">${m.name}</span>
                            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded border ${m.color}">${m.badge}</span>
                        </div>
                        <button onclick="copyModelText('${m.id}')" title="Copy response" class="text-slate-400 hover:text-white p-1 rounded hover:bg-slate-800">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                    <div id="content-${escapeId(m.id)}" class="p-4 flex-1 overflow-y-auto text-xs text-slate-300 leading-relaxed prose select-text">
                        <span class="text-slate-600 italic">Ready to receive query...</span>
                    </div>
                    <div class="px-3 py-1.5 bg-slate-950/80 border-t border-slate-800 flex items-center justify-between text-[10px] font-mono text-slate-500 shrink-0">
                        <span id="status-${escapeId(m.id)}">Idle</span>
                        <span id="timer-${escapeId(m.id)}">0.0s</span>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function renderGems() {
            const list = document.getElementById('gemsList');
            list.innerHTML = GEMS.map(g => `
                <button onclick="selectGem('${g.id}')" class="w-full text-left px-2.5 py-1.5 rounded-lg text-xs flex items-center justify-between transition ${
                    g.active ? 'bg-indigo-950/60 border border-indigo-800/80 text-indigo-200' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'
                }">
                    <span class="truncate">${g.name}</span>
                    ${g.active ? '<i data-lucide="check" class="w-3 h-3 text-indigo-400"></i>' : ''}
                </button>
            `).join('');
            lucide.createIcons();
        }

        function renderPrompts() {
            const list = document.getElementById('promptSnippets');
            list.innerHTML = PROMPTS.map((p, idx) => `
                <button onclick="usePrompt(${idx})" class="w-full text-left px-2.5 py-1 rounded text-[11px] text-slate-400 hover:bg-slate-800 hover:text-slate-200 truncate transition block">
                    ⚡ ${p.title}
                </button>
            `).join('');
        }

        function selectGem(id) {
            GEMS.forEach(g => g.active = (g.id === id));
            const active = GEMS.find(g => g.id === id);
            document.getElementById('gemIndicator').innerText = active.name;
            renderGems();
        }

        function usePrompt(idx) {
            document.getElementById('userPrompt').value = PROMPTS[idx].content;
            document.getElementById('userPrompt').focus();
        }

        function escapeId(id) {
            return id.replace(/[^a-zA-Z0-9_-]/g, '_');
        }

        // --- 4. LIVE REAL-TIME API STREAMING CORE ---
        async function dispatchMultiModelQuery() {
            const prompt = document.getElementById('userPrompt').value.trim();
            if (!prompt) return;

            const apiKey = localStorage.getItem('byok_openrouter');
            if (!apiKey) {
                alert("Please enter your OpenRouter API key in the settings to stream live models.");
                openModal('settingsModal');
                return;
            }

            if (isStreaming) return;
            isStreaming = true;

            const btn = document.getElementById('btnDispatch');
            btn.disabled = true;
            btn.innerHTML = `<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i> Streaming...`;
            lucide.createIcons();

            const activeModels = MODELS.filter(m => m.active);
            const activeGem = GEMS.find(g => g.active);
            completedOutputs = {};

            // Clear card UI states
            activeModels.forEach(m => {
                const eid = escapeId(m.id);
                document.getElementById(`content-${eid}`).innerHTML = `
                    <div class="flex items-center gap-2 text-indigo-400 text-xs">
                        <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                        <span>Connecting to live provider...</span>
                    </div>
                `;
                document.getElementById(`status-${eid}`).innerText = 'Connecting...';
                document.getElementById(`timer-${eid}`).innerText = '0.0s';
            });
            lucide.createIcons();

            // Fan-out to all active models concurrently
            const streamPromises = activeModels.map(model => 
                fetchLiveModelStream(model, prompt, activeGem.system, apiKey)
            );

            await Promise.all(streamPromises);

            isStreaming = false;
            btn.disabled = false;
            btn.innerHTML = `<i data-lucide="send" class="w-3.5 h-3.5"></i> <span>Send Query</span>`;
            lucide.createIcons();
        }

        async function fetchLiveModelStream(model, userPrompt, systemPrompt, apiKey) {
            const eid = escapeId(model.id);
            const contentBox = document.getElementById(`content-${eid}`);
            const statusBox = document.getElementById(`status-${eid}`);
            const timerBox = document.getElementById(`timer-${eid}`);

            const startTime = Date.now();
            let accumulatedRawText = "";

            const timerInterval = setInterval(() => {
                const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
                timerBox.innerText = `${elapsed}s`;
            }, 100);

            try {
                const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
                    method: "POST",
                    headers: {
                        "Authorization": `Bearer ${apiKey}`,
                        "HTTP-Referer": window.location.origin || "https://chatcollector.app",
                        "X-Title": "AI Chat Collector",
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        model: model.id,
                        messages: [
                            { role: "system", content: systemPrompt },
                            { role: "user", content: userPrompt }
                        ],
                        stream: true
                    })
                });

                if (!response.ok) {
                    const errData = await response.json().catch(() => ({}));
                    throw new Error(errData.error?.message || `HTTP ${response.status}: Failed to reach model`);
                }

                statusBox.innerText = "Receiving tokens...";
                contentBox.innerHTML = "";

                const reader = response.body.getReader();
                const decoder = new TextDecoder("utf-8");
                let buffer = "";

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split("\n");
                    buffer = lines.pop() || "";

                    for (const line of lines) {
                        const cleanLine = line.trim();
                        if (cleanLine.startsWith("data: ")) {
                            const dataPayload = cleanLine.substring(6).trim();
                            if (dataPayload === "[DONE]") break;

                            try {
                                const parsed = JSON.parse(dataPayload);
                                const tokenDelta = parsed.choices?.[0]?.delta?.content || "";
                                accumulatedRawText += tokenDelta;
                                // Parse Markdown in real time safely
                                contentBox.innerHTML = marked.parse(accumulatedRawText);
                                contentBox.scrollTop = contentBox.scrollHeight;
                            } catch (err) {
                                // Ignore non-JSON ping lines
                            }
                        }
                    }
                }

                clearInterval(timerInterval);
                statusBox.innerText = "Completed";
                completedOutputs[model.id] = accumulatedRawText;

            } catch (error) {
                clearInterval(timerInterval);
                statusBox.innerText = "Failed";
                contentBox.innerHTML = `
                    <div class="p-3 bg-rose-950/40 border border-rose-800/80 rounded-lg text-rose-300 text-xs">
                        <strong>Stream Error:</strong><br>${error.message}
                    </div>
                `;
            }
        }

        // --- 5. REAL AI CONSENSUS JUDGE ---
        async function synthesizeConsensus() {
            const apiKey = localStorage.getItem('byok_openrouter');
            if (!apiKey) {
                alert("Please add your OpenRouter API key to use the AI Consensus Judge.");
                openModal('settingsModal');
                return;
            }

            const activeKeys = Object.keys(completedOutputs);
            if (activeKeys.length < 1) {
                alert("Run a query and wait for at least one model to respond before synthesizing consensus.");
                return;
            }

            // Create loading modal
            const consensusModal = document.createElement('div');
            consensusModal.id = "consensusResultModal";
            consensusModal.className = "fixed inset-0 bg-slate-950/85 backdrop-blur-md flex items-center justify-center z-50 p-6";
            consensusModal.innerHTML = `
                <div class="bg-slate-900 border border-indigo-500/40 rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl flex flex-col max-h-[85vh]">
                    <div class="p-4 bg-indigo-950/40 border-b border-indigo-900/60 flex justify-between items-center shrink-0">
                        <div class="flex items-center gap-2">
                            <i data-lucide="git-merge" class="w-5 h-5 text-indigo-400"></i>
                            <h3 class="font-bold text-sm text-white">Live AI Consensus Synthesis</h3>
                        </div>
                        <button onclick="document.getElementById('consensusResultModal').remove()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
                    </div>
                    <div id="consensusContent" class="p-6 text-xs overflow-y-auto leading-relaxed prose">
                        <div class="flex items-center gap-2 text-indigo-400">
                            <i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>
                            <span>AI Judge is comparing responses and generating consensus matrix...</span>
                        </div>
                    </div>
                    <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-end shrink-0">
                        <button onclick="document.getElementById('consensusResultModal').remove()" class="px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs">Done</button>
                    </div>
                </div>
            `;
            document.body.appendChild(consensusModal);
            lucide.createIcons();

            // Construct synthesis prompt
            let judgePrompt = "You are an expert impartial AI Judge. Compare the following responses to the same user query. Provide:\n1. Points of Agreement\n2. Key Differences / Unique Insights\n3. Final Recommended Answer.\n\n";
            for (const [modelName, text] of Object.entries(completedOutputs)) {
                judgePrompt += `\n--- MODEL: ${modelName} ---\n${text}\n`;
            }

            try {
                const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
                    method: "POST",
                    headers: {
                        "Authorization": `Bearer ${apiKey}`,
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        model: "google/gemini-2.0-flash-exp:free", // Fast free model as judge
                        messages: [
                            { role: "system", content: "You are a professional comparative analyst." },
                            { role: "user", content: judgePrompt }
                        ]
                    })
                });

                const data = await response.json();
                const analysis = data.choices?.[0]?.message?.content || "Could not synthesize consensus.";
                document.getElementById('consensusContent').innerHTML = marked.parse(analysis);
            } catch (err) {
                document.getElementById('consensusContent').innerHTML = `
                    <div class="p-3 bg-rose-950/50 border border-rose-800 text-rose-300 rounded-lg">
                        Synthesis failed: ${err.message}
                    </div>
                `;
            }
        }

        // --- 6. UTILITIES & MODAL MANAGEMENT ---
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            document.getElementById(id).classList.add('flex');
            lucide.createIcons();
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            document.getElementById(id).classList.remove('flex');
        }

        function saveApiKeys() {
            const key = document.getElementById('inputOpenRouterKey').value.trim();
            const groqKey = document.getElementById('inputGroqKey').value.trim();

            if (key) localStorage.setItem('byok_openrouter', key);
            if (groqKey) localStorage.setItem('byok_groq', groqKey);

            checkApiKeyStatus();
            closeModal('settingsModal');
        }

        function checkApiKeyStatus() {
            const key = localStorage.getItem('byok_openrouter');
            const dot = document.getElementById('keyStatusDot');
            const text = document.getElementById('keyStatusText');

            if (key && key.startsWith('sk-or')) {
                dot.className = "w-2 h-2 rounded-full bg-emerald-500";
                text.innerText = "OpenRouter Live";
            } else {
                dot.className = "w-2 h-2 rounded-full bg-amber-500";
                text.innerText = "Key Required";
            }
        }

        function saveNewGem() {
            const name = document.getElementById('newGemName').value.trim();
            const system = document.getElementById('newGemSystem').value.trim();
            if (!name || !system) { alert('Please enter name and instructions'); return; }

            const newGem = { id: 'gem-' + Date.now(), name, system, active: true };
            GEMS.forEach(g => g.active = false);
            GEMS.push(newGem);
            renderGems();
            selectGem(newGem.id);
            closeModal('gemModal');
            document.getElementById('newGemName').value = '';
            document.getElementById('newGemSystem').value = '';
        }

        function clearScreen() {
            MODELS.forEach(m => {
                const eid = escapeId(m.id);
                const el = document.getElementById(`content-${eid}`);
                if (el) el.innerHTML = `<span class="text-slate-600 italic">Ready to receive query...</span>`;
                const stat = document.getElementById(`status-${eid}`);
                if (stat) stat.innerText = 'Idle';
                const timer = document.getElementById(`timer-${eid}`);
                if (timer) timer.innerText = '0.0s';
            });
            completedOutputs = {};
        }

        function startNewSession() {
            clearScreen();
            document.getElementById('userPrompt').value = '';
            document.getElementById('userPrompt').focus();
        }

        function copyModelText(modelId) {
            const text = completedOutputs[modelId];
            if (text) {
                navigator.clipboard.writeText(text);
                alert(`Copied output from ${modelId}!`);
            }
        }
    </script>
